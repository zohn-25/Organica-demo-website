# ==============================================================================
# Organica Environment Configuration Template
# Copy this file to .env.local for local development or set in your deployment host
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# 2. DATABASE & ORM (e.g. Prisma / Drizzle / PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/organica_db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth.js / Auth.js / Supabase Auth)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3001
# Generate secret using: openssl rand -base64 32
NEXTAUTH_SECRET="to_be_filled_when_backend_auth_is_configured"

# OAuth Providers (Optional: Google / Apple / OTP SMS)
GOOGLE_CLIENT_ID="to_be_filled"
GOOGLE_CLIENT_SECRET="to_be_filled"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY KEYS (Razorpay for India / Stripe)
# ------------------------------------------------------------------------------
# Razorpay Test / Live Keys for INR transactions in Guwahati
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="to_be_filled_with_razorpay_secret"

# ------------------------------------------------------------------------------
# 5. KITCHEN & ORDER DISPATCH CONFIGURATION (Guwahati Operations)
# ------------------------------------------------------------------------------
GUWAHATI_KITCHEN_STORE_ID="ghy-beltola-01"
WHATSAPP_DISPATCH_PHONE="+919845012345"
SUPPORT_EMAIL="orders@organica-guwahati.com"
